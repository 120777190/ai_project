# ====== 环境变量配置模板 ======
# 复制此文件为 .env，然后填入你的真实值

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型配置
DEFAULT_MODEL=deepseek-chat
SUPERVISOR_MODEL=deepseek-chat
THINKER_MODEL=deepseek-chat

# 数据存储路径
DATA_DIR=data

# 服务配置
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# 超时配置（秒）
API_TIMEOUT=60
SUPERVISOR_TIMEOUT=30